<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PocketBridge.Desktop.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme><FluentTheme.Palettes><ColorPaletteResources x:Key="Light" Accent="#315EFB"/></FluentTheme.Palettes></FluentTheme>
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter, sans-serif"/><Setter Property="Background" Value="#F8F9FC"/><Setter Property="Foreground" Value="#182237"/></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="15,10"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="#EEF2F8"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="CornerRadius" Value="8"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#315EFB"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#737E90"/></Style>
  </Application.Styles>
</Application>
