<Window x:Class="PocketBridge.CleanupDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="530" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI Variable, Segoe UI" ShowInTaskbar="False">
  <StackPanel Margin="28">
    <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,15"/>
    <TextBlock x:Name="UsageLabel" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,13" TextWrapping="Wrap"/>
    <TextBlock x:Name="Description" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
    <TextBlock Text="Gelöscht werden Fotos und Texte aus dem App-Eingang. Separat gespeicherte Dateien und Einstellungen bleiben erhalten. Die Löschung lässt sich nicht rückgängig machen." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" LineHeight="19" Margin="0,13,0,24"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Abbrechen" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" Background="Transparent"/>
      <Button Content="Einträge löschen" Click="Delete_Click" Margin="0,0,8,0"/>
      <Button Content="Behalten" Click="Keep_Click" IsDefault="True" Style="{StaticResource Primary}"/>
    </StackPanel>
  </StackPanel>
</Window>
