<Window x:Class="PocketBridge.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen · PocketBridge" Width="650" Height="880" MinWidth="550" MinHeight="650" WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI Variable, Segoe UI" ShowInTaskbar="False">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="Speicher &amp; Sprache" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="ZWISCHENSPEICHER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,23,0,10"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="LocationBox" IsReadOnly="True" Padding="10,9" FontSize="11" BorderBrush="#DFE4EE" BorderThickness="1" TextChanged="Storage_Changed" AutomationProperties.Name="Speicherort des Zwischenspeichers"/>
        <Button Grid.Column="1" Content="Ordner wählen …" Click="Browse_Click" Margin="8,0,0,0"/>
      </Grid>
      <TextBlock Text="Im gewählten Ordner wird ein eigener Ordner »PocketBridge-Eingang« angelegt." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
      <Button Content="Standardordner verwenden" Click="DefaultFolder_Click" Background="Transparent" Foreground="{StaticResource Accent}" Padding="0,9" FontSize="11" HorizontalAlignment="Left"/>
      <Border Background="#F0F3FA" CornerRadius="10" Padding="14" Margin="0,3,0,0"><StackPanel>
        <TextBlock x:Name="FreeSpaceLabel" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="CapacityHint" FontSize="11" LineHeight="18" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
      </StackPanel></Border>
      <TextBlock Text="Vorhandene Einträge werden beim Wechsel übernommen. Das Limit reserviert keinen Speicherplatz auf dem Laufwerk." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="19" Margin="0,12,0,17"/>
      <TextBlock Text="EMPFANGSSPEICHER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
      <Grid Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <Label Content="Maximal bereitgestellt (MB)" Target="{Binding ElementName=InboxMb}" Padding="0,9,12,0" FontSize="13"/>
        <TextBox x:Name="InboxMb" Grid.Column="1" Padding="10,8" FontSize="14" BorderBrush="#DFE4EE" BorderThickness="1" TextChanged="Storage_Changed" AutomationProperties.Name="Maximaler Empfangsspeicher in MB"/>
      </Grid>
      <TextBlock Text="Fotos und Texte teilen sich diesen Speicherrahmen. Anzahl und Einzelgröße sind frei, solange die gesamte Übertragung in den noch freien Platz passt. Ein niedrigerer Wert löscht keine bestehenden Einträge. MB entsprechen 1.048.576 Bytes." TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
      <Button Content="Standardwert wiederherstellen (512 MB)" Click="Defaults_Click" HorizontalAlignment="Left" Background="#F0F3FA"/>
      <TextBlock Text="SPRACHANSAGE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,25,0,12"/>
      <CheckBox x:Name="SpeechEnabled" Content="Empfang per Sprache bestätigen" FontSize="14" AutomationProperties.Name="Empfang per Sprache bestätigen"/>
      <TextBlock Text="Eine Ansage pro Übertragung nennt Anzahl und Gesamtgröße. Die Sprache folgt der Windows-Anzeigesprache; Deutsch und Englisch werden unterstützt." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="19" Margin="0,10,0,8"/>
      <TextBlock x:Name="SpeechInfo" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
      <Button Content="Ansage testen" Click="TestSpeech_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      <TextBlock x:Name="ValidationError" Foreground="#A13E36" FontSize="12" TextWrapping="Wrap" Margin="0,13,0,8" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Abbrechen" IsCancel="True" Background="Transparent" Margin="0,0,10,0"/>
      <Button x:Name="SaveButton" Content="Speichern" Click="Save_Click" IsDefault="True" Style="{StaticResource Primary}"/>
    </StackPanel>
  </Grid>
</Window>
