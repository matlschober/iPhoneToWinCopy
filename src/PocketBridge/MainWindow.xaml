<Window x:Class="PocketBridge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PocketBridge" Icon="Assets/pocketbridge.ico" Width="1240" Height="810" MinWidth="1000" MinHeight="680" Background="#F8F9FC" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E8EBF2" BorderThickness="0,0,0,1">
      <Grid Margin="30,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#315EFB" CornerRadius="12" Width="42" Height="42" Margin="0,0,13,0"><TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel><TextBlock Text="PocketBridge" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="DEIN IPHONE. DEIN PC. DIREKT VERBUNDEN." FontSize="9" Foreground="{StaticResource Muted}" Margin="1,3,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Fill="#315EFB" Width="7" Height="7" Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusLabel" Text="Wird gestartet …" VerticalAlignment="Center" FontSize="12" Margin="0,0,22,0"/>
          <Button x:Name="PauseButton" Content="Pausieren" Click="Pause_Click" IsEnabled="False"/>
          <Button x:Name="SettingsButton" Content="Einstellungen" Click="Settings_Click" Margin="10,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#F0F3FA" BorderBrush="#E5E9F2" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25,30">
          <TextBlock Text="VERBINDUNG" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="iPhone verbinden" FontSize="20" FontWeight="SemiBold" Margin="0,15,0,7"/>
          <TextBlock Text="QR-Code mit der Kamera scannen.&#x0a;Beide Geräte im selben Netzwerk." FontSize="12" Foreground="{StaticResource Muted}" LineHeight="19"/>
          <Border Background="White" CornerRadius="14" Padding="12" Margin="0,24,0,16" HorizontalAlignment="Left">
            <Image x:Name="QrImage" Width="190" Height="190" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR-Code zum Verbinden"/>
          </Border>
          <TextBlock Text="NETZWERKADRESSE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,2,0,7"/>
          <ComboBox x:Name="AddressBox" SelectionChanged="Address_Changed" AutomationProperties.Name="Netzwerkadresse"/>
          <Button Content="Verbindungslink kopieren" Click="CopyLink_Click" Margin="0,10,0,0" Background="White"/>
          <TextBlock Text="Der Link enthält deinen Zugangsschlüssel." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
          <Border Height="1" Background="#DDE3EF" Margin="0,24,0,21"/>
          <TextBlock Text="Direkt aus »Teilen« senden" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock Text="Mit einem iPhone-Kurzbefehl Fotos, Links und Text an diesen PC senden." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="19" Margin="0,7,0,13"/>
          <Button Content="Einrichtung ansehen  ↗" Click="Guide_Click" Background="White"/>
          <Button Content="Zugangsschlüssel erneuern" Click="Rotate_Click" Background="Transparent" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
        </StackPanel></ScrollViewer>
      </Border>
      <Border Grid.Column="1" Background="White" BorderBrush="#E8EBF2" BorderThickness="0,0,1,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <Grid Margin="23,28,23,18"><TextBlock Text="Eingang" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></Grid>
          <Grid Grid.Row="1" Margin="22,0,22,18">
            <TextBox x:Name="SearchBox" Padding="10,9" BorderBrush="#E1E6EF" BorderThickness="1" Background="#F8F9FC" TextChanged="Search_Changed" ToolTip="Eingang durchsuchen" AutomationProperties.Name="Eingang durchsuchen"/>
            <TextBlock Text="Eingang durchsuchen" Margin="11,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </Grid>
          <ListBox x:Name="InboxList" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Inbox_SelectionChanged" Padding="10,0" AutomationProperties.Name="Empfangene Inhalte">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Padding" Value="12,15"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F5F7FC"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDF2FF"/></Trigger>
              </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#315EFB" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
            </Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="ListEmpty" Grid.Row="2" Text="Hier kommt dein nächster&#x0a;Gedanke an." Foreground="{StaticResource Muted}" FontSize="13" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <Grid Grid.Column="2" Margin="30,29,30,26">
        <Grid x:Name="EmptyView">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30">
            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Foreground="#315EFB" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,27"/>
            <TextBlock Text="Bereit für deinen Transfer." FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock Text="Ein Foto. Ein Link. Ein bisschen Text.&#x0a;Vom iPhone direkt hierher." Foreground="{StaticResource Muted}" FontSize="14" LineHeight="23" TextAlignment="Center" Margin="0,13,0,28"/>
            <Border Background="#EBEFF8" CornerRadius="8" Padding="17,10" HorizontalAlignment="Center"><TextBlock Text="Kamera öffnen → QR-Code scannen" FontSize="12"/></Border>
          </StackPanel>
        </Grid>
        <Grid x:Name="DetailView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="VORSCHAU" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ItemTitle" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,7" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ItemMeta" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel>
          <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="0,24,0,24" ClipToBounds="True">
            <Grid>
              <Image x:Name="PhotoPreview" Margin="16" Stretch="Uniform"/>
              <TextBox x:Name="TextPreview" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="24" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="17" Foreground="{StaticResource Ink}"/>
              <TextBlock x:Name="PreviewError" Visibility="Collapsed" Margin="24" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            </Grid>
          </Border>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><Button x:Name="CopyButton" Content="Kopieren" Click="Copy_Click" Style="{StaticResource Primary}" MinWidth="120" Margin="0,0,10,0"/><Button Content="Speichern …" Click="Save_Click"/></StackPanel>
            <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Click="Delete_Click" ToolTip="Aus dem Eingang löschen" AutomationProperties.Name="Eintrag löschen" Background="Transparent" Foreground="{StaticResource Muted}"/>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="#E5E9F2" BorderThickness="0,1,0,0" Background="White">
      <Grid Margin="25,0"><TextBlock x:Name="Feedback" Text="Lokal im Netzwerk · Keine Cloud · Originale bleiben erhalten" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="POCKETBRIDGE / 01" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </Border>
  </Grid>
</Window>
